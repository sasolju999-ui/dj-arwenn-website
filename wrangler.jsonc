{
  "name": "dj-arwenn-website",
  "keep_vars": true,
  "main": "worker.js",
  "compatibility_date": "2026-11-03",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dj-arwenn-bookings",
      "database_id": "3c39c3fd-8e7d-4691-a52b-e1518433ec66"
    }
  ],
  "vars": {
    "TURNSTILE_SITE_KEY": "0x4AAAAAAAFy72_XM3bNynqhT",
    "ENQUIRY_TURNSTILE_ENABLED": "true"
  }
}
